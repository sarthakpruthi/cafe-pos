{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    // Both are needed: the Worker runtime globals come from workers-types, and the Express API
    // sources it imports use Node built-ins (node:crypto, node:async_hooks, ...).
    "types": ["@cloudflare/workers-types", "node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["index.ts", "env.ts", "realtime-do.ts", "stream.ts", "iconv-lite.ts"]
}
