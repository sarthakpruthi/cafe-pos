NODE_ENV=development
PORT=4000
# Leave DATABASE_URL empty to use the built-in local database (fine for trying things out).
# For a real cafe, use a PostgreSQL address like postgresql://user:password@host:5432/cafe
#
# Supabase: Project Settings -> Database -> Connection string. Use the "Session pooler" string
# (port 5432) — it works over IPv4 and supports the transactions this app uses. For example:
#   DATABASE_URL=postgresql://postgres.abcdefghijklmnop:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# URL-encode the password if it contains @ : / ? # [ ] characters. TLS is turned on automatically.
# If certificate checks ever fail on your network, add ?sslmode=no-verify to the end of the URL.
DATABASE_URL=
# The public web address of the app. QR codes are built from this, so set it BEFORE printing them.
FRONTEND_URL=http://localhost:4000
API_BASE_URL=http://localhost:4000
AUTH_SECRET=replace-with-a-long-random-secret
CAFE_NAME=The TeaPot Cafe
CAFE_TIMEZONE=Asia/Kolkata
