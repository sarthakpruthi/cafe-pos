NODE_ENV=development
PORT=4000
# Leave DATABASE_URL empty to use the built-in local database (fine for trying things out).
# For a real cafe, use a PostgreSQL address like postgresql://user:password@host:5432/cafe
#
# Supabase: Project Settings -> Database -> Connection string. Use the "Session pooler" string
# (port 5432) — it works over IPv4 and supports the transactions this app uses. For example:
#   DATABASE_URL=postgresql://postgres.abcdefghijklmnop:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# URL-encode the password if it contains @ : / ? # [ ] characters. TLS is switched on automatically.
# Supabase signs with its own certificate authority, which Node does not trust, so the certificate is
# NOT checked by default (the same as Supabase's own examples). For full verification, download the CA
# from Supabase (Project Settings > Database > SSL Configuration) and set:
#   DATABASE_SSL_CA=/path/to/prod-ca-2021.crt
# DATABASE_SSL=verify checks against Node's built-in list instead; DATABASE_SSL=disable turns TLS off.
DATABASE_URL=
# The public web address of the app. QR codes are built from this, so set it BEFORE printing them.
FRONTEND_URL=http://localhost:4000
API_BASE_URL=http://localhost:4000
# Signs customer table-session tokens (staff sign-in is handled by Supabase). Required in production.
AUTH_SECRET=replace-with-a-long-random-secret
# Lets the public /setup page create a cafe and its first manager without signing in.
# Leave empty to switch that page off entirely. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_SETUP_KEY=
CAFE_NAME=The TeaPot Cafe
CAFE_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------- Staff sign-in (Supabase Auth)
# Supabase > Project Settings > API.
SUPABASE_URL=
# The service_role key. SECRET: server only, never expose it to the browser.
# It is used to create staff logins and to reset their passwords.
SUPABASE_SERVICE_ROLE_KEY=
# Only for older projects, which sign access tokens with a shared secret
# (Project Settings > API > JWT Settings). Leave empty on newer projects, which publish a JWKS.
SUPABASE_JWT_SECRET=
# Staff type a username, but Supabase needs an email: "sam" becomes "sam@<this domain>".
# Anything works - the address is never emailed. Keep this and VITE_STAFF_EMAIL_DOMAIN the same.
STAFF_EMAIL_DOMAIN=cafe.local

# The web app is built with these. The anon key is public and safe to ship to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_STAFF_EMAIL_DOMAIN=cafe.local
